# ── LLM provider ─────────────────────────────────────────────────────────────
# Choose one: groq (free cloud) | anthropic (Claude) | openai (Ollama / any
# OpenAI-compatible endpoint). Default is groq.
LLM_PROVIDER=groq

# ── Groq (free) — get a key at https://console.groq.com/keys ─────────────────
GROQ_API_KEY=your_groq_key_here
# Optional: override the model. See https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b

# ── Anthropic (only if LLM_PROVIDER=anthropic) ───────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Local / OpenAI-compatible (only if LLM_PROVIDER=openai) ──────────────────
# For Ollama (free, local): install from https://ollama.com, run `ollama pull llama3.2:3b`
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2:3b
# OPENAI_API_KEY=not-needed

PORT=3001

# ── Stage 4 (confidence allocation under deterioration) ──────────────────────
# Both required. The server refuses to start (FATAL, process.exit(1)) if
# either is missing — a missing key or answer key is a deployment fault, not
# a runtime surprise. See server/stage4/routes.js.

# HMAC secret used to sign stage-4 session tokens and completion tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STAGE4_SESSION_SECRET=replace_with_a_generated_secret

# Optional override for where the private answer key module lives. Defaults
# to server/stage4/answers.private.js, which is gitignored and never
# committed. In production this points at a Render secret file, e.g.
# /etc/secrets/answers.private.js.
# STAGE4_ANSWERS_PATH=/etc/secrets/answers.private.js
